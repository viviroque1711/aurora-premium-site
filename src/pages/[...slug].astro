---
// Rota única das páginas importadas de pacotes (src/content-pages/<slug>/).
// Conteúdo, CSS, JSON-LD e script saem exatamente como vieram no pacote.
import { pageDirs, pageParts } from '../lib/pages.mjs';

export function getStaticPaths() {
  return pageDirs().map((dir) => ({ params: { slug: dir === '_home' ? undefined : dir }, props: { dir } }));
}

const parts = pageParts(Astro.props.dir);
const { css, ld } = parts;
let { head, body, js } = parts;
// Ambiente de teste (GitHub Pages em /aurora-premium-site/): noindex e caminhos/links apontando para o próprio teste.
if (process.env.SITE_ENV === 'staging') {
  const base = '/aurora-premium-site';
  const fix = (s) => s.replace(/(src|href)="\/(?!\/)/g, `$1="${base}/`).replace(/href="https:\/\/aurorapremium\.com\//g, `href="${base}/`);
  head = fix(head.replace(/<meta name="robots" content="[^"]*">/, '<meta name="robots" content="noindex, nofollow">'));
  body = fix(body);
}
---
<!doctype html>
<html lang="pt-BR">
<head>
<Fragment set:html={head} />
<script type="application/ld+json" is:inline set:html={ld}></script>
<style is:inline set:html={css}></style>
</head>
<body>
<Fragment set:html={body} />
<script is:inline set:html={js}></script>
</body>
</html>
