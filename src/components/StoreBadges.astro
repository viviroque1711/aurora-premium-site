---
// Botões das lojas de aplicativos no rodapé. Não renderiza NADA enquanto nenhuma loja estiver ligada em
// src/data/stores.mjs (hoje: só o Google Play, desde 16/11/2026). Loja com `selo` mostra o selo oficial sem alteração
// (as lojas exigem o selo oficial, baixado das páginas de marca delas); a que não tem selo mostra o botão de texto.
import { lojasAtivas, linkComMedicao, paginaParaMedicao } from '../data/stores.mjs';

const lojas = lojasAtivas();
// Medição de instalações: o Google Play devolve o `referrer` no Play Console (Aquisição). Um link por página, com a página
// em utm_content, mostra de qual página do site veio cada instalação. Só o Google Play usa isso; a App Store não.
const { local = 'rodape' } = Astro.props; // rodape (padrão), menu...
const pagina = paginaParaMedicao(Astro.url.pathname);
const comMedicao = (l) => linkComMedicao(l, local, pagina);
---
{lojas.length > 0 && (
  <ul class="ap-stores" aria-label="Aplicativo do Aurora Premium">
    {lojas.map((l) => (
      <li>
        {l.selo ? (
          <a class="ap-store-selo" href={comMedicao(l)} rel="noopener" aria-label={l.label}>
            <img src={l.selo.src} width={l.selo.width} height={l.selo.height} alt={l.label} loading="lazy" decoding="async" />
          </a>
        ) : (
          <a class="ap-store" href={comMedicao(l)} rel="noopener" aria-label={l.label}>
            <span class="ap-store-pre">{l.prefixo}</span>
            <span class="ap-store-name">{l.texto}</span>
          </a>
        )}
      </li>
    ))}
  </ul>
)}
